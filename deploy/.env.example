# Deployment configuration. Copy this file to `deploy/.env`.
#
# No keys go in here: the APP_KEY is generated inside the volume on first start,
# and the master password never reaches the server at all.

# Domain pointing at this server. It has to resolve in DNS *before* you bring
# the container up, or Let's Encrypt cannot issue the certificate.
VAULT_DOMAIN=vault.example.com

# Name shown in the browser and when registering passkeys.
VAULT_NAME=Vault
